// Схема БД FitHome — 8 сущностей (этап 4: добавлена WorkoutSet).
// Каноническое описание полей и правил целостности: docs/database.md
// Контракты API, работающие с этими сущностями: docs/api.md
//
// Переход на PostgreSQL (docs/database.md §8) требует изменения только
// поля `provider` ниже и переменной DATABASE_URL в .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // при переходе на PostgreSQL: provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Учётная запись пользователя (docs/database.md §2.1)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // логин, хранится в нижнем регистре
  passwordHash String // bcrypt-хеш пароля (cost 10)
  name         String // отображаемое имя
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exercises     Exercise[] // обратная связь для персональных упражнений (Exercise.userId)
  settings      UserSettings?
  programs      Program[]
  workouts      Workout[]
  refreshTokens RefreshToken[]
  sharesSent     ProgramShare[] @relation("ProgramSharesFrom")
  sharesReceived ProgramShare[] @relation("ProgramSharesTo")

  @@map("users")
}

/// Refresh-сессия: хранится только SHA-256-хеш refresh-токена (docs/database.md §2.8)
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // sha256-хеш refresh-токена — не хранится в открытом виде
  expiresAt DateTime // момент истечения (30 дней с выдачи)
  createdAt DateTime  @default(now())
  revokedAt DateTime? // момент ротации/выхода; не null — сессия отозвана

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Настройки пользователя — ровно одна запись на пользователя (docs/database.md §2.2)
model UserSettings {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  unit            String  @default("kg") // "kg" | "lb"
  theme           String  @default("system") // "light" | "dark" | "system"
  reminderTime    String? // время напоминания "HH:mm" (локальное)
  reminderEnabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

/// Упражнение: общее (userId = null) или персональное (docs/database.md §2.3)
model Exercise {
  id           Int      @id @default(autoincrement())
  name         String
  nameLower    String // название в нижнем регистре для кириллического поиска (JS toLowerCase, см. docs/stage0-experiments.md)
  description  String?
  place        String // "home" | "outdoor" | "gym"
  metric       String // "reps" | "reps_weight" | "time"
  muscleGroups String // канонический CSV с ограничивающими запятыми: ",chest,triceps," — точное совпадение токенов в фильтрах
  difficulty   String // "easy" | "medium" | "hard"
  equipment    String? // канонический CSV инвентаря (",dumbbell,bench,") или null — без инвентаря
  userId       Int? // null — общее упражнение каталога
  createdAt    DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  programExercise ProgramExercise[]
  workoutResults  WorkoutResult[]

  @@unique([userId, name]) // в SQLite NULL в составном ключе различим — идемпотентность общих упражнений обеспечивает seed (findFirst)
  @@index([place])
  @@index([userId])
  @@map("exercises")
}

/// Программа тренировок; userId = null — готовая общедоступная программа каталога (docs/database.md §2.4)
model Program {
  id          Int      @id @default(autoincrement())
  userId      Int? // null — готовая программа (read-only для всех); задан — программа владельца
  name        String
  description String?
  place       String // "home" | "outdoor" | "gym"
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(false) // добровольная публикация в общую библиотеку
  publishedAt DateTime? // момент публикации; null — не опубликована
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
  workouts  Workout[]
  shares    ProgramShare[]

  @@index([userId, isActive])
  @@index([isPublic, isActive])
  @@map("programs")
}

/// Отправка программы конкретному пользователю (этап 5).
/// Статусы: pending | saved | declined. Копия при сохранении независима.
model ProgramShare {
  id         Int      @id @default(autoincrement())
  programId  Int
  fromUserId Int
  toUserId   Int
  status     String   @default("pending") // pending | saved | declined
  createdAt  DateTime @default(now())

  program  Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  fromUser User    @relation("ProgramSharesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User    @relation("ProgramSharesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([toUserId, status])
  @@index([fromUserId])
  @@map("program_shares")
}

/// Упражнение в составе программы с целевыми нагрузками (docs/database.md §2.5)
model ProgramExercise {
  id            Int     @id @default(autoincrement())
  programId     Int
  exerciseId    Int
  order         Int // порядок выполнения в программе (с 1)
  targetSets    Int     @default(3)
  targetReps    Int? // для метрики "reps" и "reps_weight"
  targetWeight  Decimal? // для метрики "reps_weight"
  targetDuration Int? // сек, для метрики "time"
  restSec       Int     @default(90) // перерыв между подходами, сек (0 — без перерыва)

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutResults WorkoutResult[] // результаты, скопированные из плана при старте тренировки (SetNull при удалении)

  @@unique([programId, order])
  @@index([exerciseId])
  @@map("program_exercises")
}

/// Тренировка: in_progress | completed | cancelled; programId = null — свободная (docs/database.md §2.6)
/// Активная (in_progress) — максимум одна на пользователя: частичный уникальный индекс
/// workouts_user_active_uq (userId) WHERE status = 'in_progress' создаётся в миграции stage4.
model Workout {
  id          Int       @id @default(autoincrement())
  userId      Int
  programId   Int? // null — свободная тренировка; SetNull при удалении программы
  programName String? // снапшот названия программы на момент старта (только сервер)
  place       String // "home" | "outdoor" | "gym"
  status      String    @default("in_progress") // "in_progress" | "completed" | "cancelled"
  revision    Int       @default(0) // CAS автосохранения и завершения (план этапа 4 v3 §4 п.2)
  startedAt   DateTime  @default(now())
  completedAt DateTime? // устанавливается только сервером при завершении
  durationSec Int? // completedAt - startedAt, считает сервер
  notes       String?
  createdAt   DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  results WorkoutResult[]

  @@index([userId, startedAt]) // история и статистика
  @@map("workouts")
}

/// Результат одного упражнения в рамках тренировки (docs/database.md §2.7)
/// Снапшоты exerciseName/exerciseMetric заполняет только сервер — история корректна
/// после удаления/переименования упражнения (exerciseId → SetNull).
model WorkoutResult {
  id                Int      @id @default(autoincrement())
  workoutId         Int
  exerciseId        Int? // null после удаления упражнения (SetNull)
  programExerciseId Int? // элемент плана программы, из которого скопирован результат (SetNull)
  exerciseName      String // снапшот названия упражнения
  exerciseMetric    String // снапшот метрики: "reps" | "reps_weight" | "time"
  order             Int // позиция в тренировке (с 1)
  skipped           Boolean  @default(false) // упражнение пропущено целиком
  notes             String?
  createdAt         DateTime @default(now())

  workout         Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  programExercise ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]

  @@unique([workoutId, order]) // уникальность порядка упражнений в тренировке (план v3 §4 п.5)
  @@index([exerciseId])
  @@map("workout_results")
}

/// Отдельный подход в рамках результата упражнения (этап 4, план v3 §2)
/// Заполненность reps/weight/duration определяется снапшотом exerciseMetric родителя.
model WorkoutSet {
  id              Int      @id @default(autoincrement())
  workoutResultId Int
  order           Int // номер подхода (с 1)
  reps            Int? // для метрик "reps" и "reps_weight"
  weight          Decimal? // для метрики "reps_weight"
  duration        Int? // сек, для метрики "time"
  skipped         Boolean  @default(false) // подход пропущен

  workoutResult WorkoutResult @relation(fields: [workoutResultId], references: [id], onDelete: Cascade)

  @@unique([workoutResultId, order]) // уникальность порядка подходов (план v3 §4 п.5)
  @@map("workout_sets")
}
