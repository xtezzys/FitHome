# Порт API-сервера
PORT=4000

# Подключение к базе данных (SQLite). При переходе на PostgreSQL меняется только
# эта переменная и provider в prisma/schema.prisma — см. docs/database.md §8
DATABASE_URL="file:./dev.db"

# Секреты подписи JWT (сгенерировать, например: openssl rand -hex 32)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Origin SPA, которому разрешён CORS с credentials (httpOnly refresh-cookie)
CORS_ORIGIN="http://localhost:5173"
