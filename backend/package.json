{
  "name": "fithome-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FitHome API — Node.js + Express + TypeScript + Prisma (SQLite)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tooling": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --esModuleInterop --skipLibCheck prisma/seed.ts prisma/backfill-stage3.ts prisma/verify-stage3.ts prisma/stage3/normalize.ts scripts/stage3-migrate.ts scripts/stage3-verify-integration.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "stage0:generate": "prisma generate --schema prisma/stage0/probe.prisma",
    "stage0:run": "tsx prisma/stage0/run-all.ts",
    "stage3:migrate": "tsx scripts/stage3-migrate.ts",
    "stage3:verify-integration": "tsx scripts/stage3-verify-integration.ts",
    "db:backfill-stage3": "tsx prisma/backfill-stage3.ts",
    "db:verify-stage3": "tsx prisma/verify-stage3.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.0.4",
    "prisma": "^6.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "vitest-mock-extended": "^3.0.1"
  }
}
